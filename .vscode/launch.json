{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "attach",
      "name": "Chrome attach",
      "port": 9222,
      "urlFilter": "http://localhost:8000/*",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest Current",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runInBand", "${fileBasenameNoExtension}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Python: Correct comm timezones (dry-run)",
      "program": "${workspaceFolder}/src/server-batch/1_comm/6a_correct_timezones.py",
      "args": [
        "--debug",
        "--min-age-minutes",
        "0",
        "--start-date",
        "2015-05-13",
        "--end-date",
        "2015-05-13"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
